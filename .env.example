# ==========================================
# TgActor Environment Variables Configuration
# ==========================================

# PostgreSQL Connection String (Default for docker-compose)
DATABASE_URL=postgresql+asyncpg://tgactor:tgactor_password@db:5432/tgactor_db

# Redis Connection String (Default for docker-compose)
REDIS_URL=redis://redis:6379/0

# Encryption Key / Secret Key for storing Telegram Sessions securely
# REQUIRED: Generate one in python via:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=your_generated_encryption_key_here
SECRET_KEY=your_generated_secret_key_here

# Admin Password for the Web UI
ADMIN_PASSWORD=admin

# Global Proxy Setting (Default)
# Read by proxy_service.py; strict mode: accounts without a bound proxy are blocked
USE_PROXY=True

# Background Service Toggles (Optional: Defaults to True for automatic background daemons)
ENABLE_CHANNEL_MONITOR=True
ENABLE_INBOX_LISTENER=True
