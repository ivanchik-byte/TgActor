# ==========================================
# TgCast Environment Variables Configuration
# ==========================================

# PostgreSQL Connection String (Default for docker-compose)
DATABASE_URL=postgresql+asyncpg://tgcast:tgcast_password@db:5432/tgcast_db

# Redis Connection String (Default for docker-compose)
REDIS_URL=redis://redis:6379/0

# Encryption Key for storing Telegram Sessions securely
# REQUIRED: Generate one in python via:
# >>> from cryptography.fernet import Fernet
# >>> print(Fernet.generate_key().decode())
ENCRYPTION_KEY=your_generated_encryption_key_here

# Admin Password for the Web UI (B2B Dashboard)
ADMIN_PASSWORD=admin

# Global Proxy Setting (Default)
USE_PROXY_DEFAULT=True
