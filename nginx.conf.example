# Nginx Configuration Example for TgCast with HTTPS (Certbot)
# Copy this file to /etc/nginx/sites-available/tgcast and edit server_name

server {
    listen 80;
    server_name tgcast.example.com www.tgcast.example.com;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support for Unified Inbox (/ws/inbox)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
